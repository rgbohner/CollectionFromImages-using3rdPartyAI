{
  "name": "collection-from-images",
  "version": "1.0.0",
  "private": true,
  "description": "Build a collection spreadsheet from a directory of photographs.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "collection-from-images": "bin/collection-from-images.cjs"
  },
  "main": "lib/collection.cjs",
  "files": [
    "bin/",
    "lib/",
    "examples/",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "start": "node bin/collection-from-images.cjs",
    "dev": "node --env-file=.env bin/collection-from-images.cjs",
    "test": "node --test tests/*.test.cjs",
    "mcp": "node bin/collection-from-images.cjs mcp"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "heic-convert": "2.1.0",
    "sharp": "0.34.5"
  }
}
