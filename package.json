{
  "name": "collection-from-images-using3rdpartyai",
  "version": "1.0.0",
  "private": true,
  "description": "Build collection spreadsheets using third-party OpenAI or Google Gemini models; no custom classifier.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "collection-from-images-using3rdpartyai": "bin/collection-from-images.cjs",
    "collection-from-images": "bin/collection-from-images.cjs"
  },
  "main": "lib/collection.cjs",
  "files": [
    "bin/",
    "lib/",
    "config/",
    "examples/",
    "README.md",
    "NOTICE.md",
    "FILE_GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/collection-from-images.cjs",
    "dev": "node --env-file=.env bin/collection-from-images.cjs",
    "test": "node --test tests/*.test.cjs",
    "sample:coins": "node examples/run-coins.cjs",
    "sample:msg": "node examples/run-msg.cjs",
    "sample:comics": "node examples/run-comics.cjs",
    "mcp": "node bin/collection-from-images.cjs mcp"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "heic-convert": "2.1.0",
    "sharp": "0.34.5"
  }
}
